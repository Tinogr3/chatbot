# =============================================================================
# PLANTILLA PARA .env — copia este archivo y rellena cada valor.
# Uso: cp .env.example .env
# Nunca subas .env al repositorio (ya está en .gitignore).
# =============================================================================

# Indica a docker-compose que use este archivo como env_file en los contenedores.
COMPOSE_ENV_FILE=.env

# ── Google Cloud ──────────────────────────────────────────────────────────────
# Ruta ABSOLUTA en el host al JSON de la service account de GCP.
# Se monta en los contenedores como /app/credentials.json (solo lectura).
# Ejemplo Linux/Mac:  /home/usuario/keys/mi-service-account.json
# Ejemplo Windows:    C:/Users/usuario/keys/mi-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/ruta/absoluta/a/service-account.json
PROJECT_ID=tu-project-id
GOOGLE_API_KEY=tu-api-key
BUCKET_NAME=tu-bucket-name

# ── Modelos Gemini ─────────────────────────────────────────────────────────────
# Consulta modelos disponibles en: https://ai.google.dev/gemini-api/docs/models
GEMINI_AI_MODEL_FLASH=gemini-1.5-flash
GEMINI_AI_MODEL_PRO=gemini-1.5-pro

# ── PostgreSQL (servicio 'db' de docker-compose) ───────────────────────────────
POSTGRES_USER=usuario
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=chatbot_db
# URL utilizada por herramientas externas (psql, DBeaver…) desde el host.
# Dentro de los contenedores docker-compose construye la URL con el host interno 'db'.
DATABASE_URL=postgresql+asyncpg://usuario:cambia_esta_password@localhost:5432/chatbot_db

# ── Redis / Celery ────────────────────────────────────────────────────────────
# docker-compose sobreescribe CELERY_BROKER_URL con redis://redis:6379/0 en los contenedores.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_WORKER_CONCURRENCY=2
CELERY_PREFETCH_MULTIPLIER=1

# ── CORS ───────────────────────────────────────────────────────────────────────
# Lista separada por comas. En producción añade el dominio real del frontend.
# Con allow_credentials=True no se puede usar '*'.
ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL del backend vista desde el navegador del usuario.
# Si el backend está en un servidor remoto, cambia este valor antes de hacer build.
# (La variable se usa en tiempo de compilación de Next.js dentro de Docker.)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ── RAG ────────────────────────────────────────────────────────────────────────
RAG_THREAD_POOL_WORKERS=4
RAG_ENABLE_DOCUMENT_CARD=true
RAG_ENABLE_IMAGE_EXTRACTION=true
RAG_MAX_PAGES_FOR_IMAGES=500
RAG_MAX_IMAGES_PER_PDF=50
RAG_VECTOR_BATCH_SIZE=50
# Hilos para describir imágenes con Gemini Vision en paralelo (1–16).
RAG_IMAGE_DESCRIPTION_WORKERS=8
