# Copia este archivo a .env y rellena los valores antes de desplegar.
#   cp .env.example .env

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=chatbot

# ── Google Cloud ─────────────────────────────────────────────────────────────
# Ruta absoluta en el host al JSON de la service account
GOOGLE_APPLICATION_CREDENTIALS=/ruta/absoluta/service-account.json
GOOGLE_API_KEY=tu-api-key
PROJECT_ID=tu-project-id
BUCKET_NAME=tu-bucket-name

# ── Autenticación y CORS ─────────────────────────────────────────────────────
# Genera JWT_SECRET_KEY con: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=cambia_esto_con_secrets_token_hex_64
ALLOWED_ORIGINS=http://localhost:3000

# development | production
ENVIRONMENT=development
# En local sin HTTPS deja false; en producción con TLS usa true
COOKIE_SECURE=false

# ── Frontend (build-time, se incrusta en el bundle de Next.js) ───────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
